# Copy this file to .env and fill in real values.

# App config
APP_ENV=development

# --- Chunking ---
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

# --- Retrieval ---
DEFAULT_TOP_K=5
RRF_K=60
FUSION_CANDIDATE_POOL=30
RERANK_TOP_N=20

# --- Dense embeddings (local sentence-transformers model, no API key needed) ---
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Cross-encoder reranker ---
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# --- Qdrant vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks

# --- Generation LLM (local Ollama, must be installed + running separately) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=60

# --- Frontend (Flask UI, proxies to the FastAPI backend above) ---
BACKEND_URL=http://localhost:8000
FRONTEND_PORT=5000
FRONTEND_DEBUG=true
